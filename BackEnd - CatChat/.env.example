# Server Configuration
PORT=3000

# Database Configuration (MySQL / Railway MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=catchat

# JWT Secret (Gunakan string acak yang aman di production)
JWT_SECRET=your_jwt_secret_key_here

# Encryption Key for AES-256 (Harus tepat 32 karakter)
ENCRYPTION_KEY=12345678901234567890123456789012

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

